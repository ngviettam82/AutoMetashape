FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Install base dependencies and Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    net-tools \
    python3 \
    python3-pip \
    python3-setuptools \
    && rm -rf /var/lib/apt/lists/*

# Set up workspace
WORKDIR /workspace/autometashape

# Copy project files
COPY . /workspace/autometashape

# Install development & verification tools
RUN pip3 install --no-cache-dir ruff pytest

# Default entrypoint
CMD ["bash", "build.sh"]
