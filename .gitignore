# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/

# C / C++ / CUDA Build artifacts
build/
dist/
bin/
*.obj
*.mtl
*.exe
*.lib
*.a
*.pdb
*.exp

# Datasets, Metashape projects, and large transient deliverables
data/
outputs/
recordings/
*.psx
*.files/
*.glb
*.fbx
*.ply
*.laz
*.las
*.e57
*.spz
*.tar
*.zip
*.tif
*.tiff
*.tfw
*.prj
*.JPG
*.jpg
*.PNG
*.png

# Ignore raw 3D splat binary files
*.splat
**/*.splat

**/__pycache__/
**/*.egg-info/

# Virtual environments
.venv/
.venv*/
venv/
ENV/
env/

# IDE / Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Testing, Linting & Coverage
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# Local Node, Cluster Configuration & Runtime Signals
worker_config.json
server_config.json
_autometashape_status.json
.update_pending
.abort_pending
*.pid
*.log

# Agent workspace quarantine (Isaac Standard)
.agents/*
!.agents/skills.json
!.agents/skills/
!.agents/rules/
scratch/
.taste-skill/
*.tmp
